.lead {
   max-width: 984px;
   max-height: 983px;
    margin: 90px 148px 92px;
    display: flex;
    flex-direction: column;
    position: relative;
    align-items: center;
    justify-content: center;
}

.lead__title {
    width: 720px;
    height: 200px;
    position: relative;
    opacity: 1;
    font-family: "inter";
    font-weight: 900px;
    font-style: black;
    font-size: 96px;
    line-height: 100px;
    letter-spacing: 0px;
    margin: 0 auto;
    text-align: center;
}

.lead__subtitle {
    width:720px;
    height: 72px;
    margin: 32px auto 64px;
    font-family: "inter";
    font-weight: 400px;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: 0px;
    text-align: center;
    
}


.lead__image {
    position: relative;
    width: 100%;
    height: 615px;


}